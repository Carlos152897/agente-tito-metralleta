# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# Solo respaldo inicial: una vez que la app arranca, actualízala desde /ajustes
# (surte efecto al instante, sin reiniciar el server) — esto queda pisado por
# data/marketsnack-cookie.json en cuanto exista ese archivo.
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# Schwab Trader API — producto "Market Data Production" (option chains, quotes, price history).
# developer.schwab.com → My Apps → tu app → App Key / Secret. Redirect URI debe coincidir con el registrado en el portal.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
